{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ESNext"],
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "lib",
        "noEmit": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": ["node_modules", "lib"],
    "include": ["index.ts", "schemaless.ts", "tests/**/*.ts", "src/**/*.ts", "tests/__mocks__/fs.js", "tests/__mocks__/promises/fs.js"]
}
